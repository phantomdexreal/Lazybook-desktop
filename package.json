{
  "name": "lazybooks-desktop",
  "version": "0.0.0",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "description": "LazyBooks Desktop (Connector)",
  "author": "LazyBooks",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:app": "electron-vite dev",
    "mock-tally": "node tools/mock-tally/server.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild:native": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "icons": "node tools/gen-icons.mjs",
    "release:meta": "node tools/release-meta.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.11",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
