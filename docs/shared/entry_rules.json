 "semantic_checks": [
  {
   "id": "S01",
   "detail": "COMPANY_MISMATCH",
   "rule": "envelope.company_guid must be the company the connector is bound to (tm_company.guid)"
  },
  {
   "id": "S02",
   "detail": "DATE_OUT_OF_PERIOD",
   "rule": "voucher date must lie in [tm_company.starting_from, tm_company.ending_at]"
  },
  {
   "id": "S03",
   "detail": "VOUCHER_TYPE_MISMATCH",
   "rule": "data.base_kind must equal tm_voucher_type.base_kind of voucher_type_guid and be in the kind allowed_base_kinds; quotation requires voucher_type_guid = app_settings.quotation_voucher_type_guid"
  },
  {
   "id": "S04",
   "detail": "TOTAL_MISMATCH",
   "rule": "each invoice line amount = round2(qty*rate*(1-discount_pct/100)); total = sum(line amounts)+sum(charges)+sum(tax line amounts)+round_off.amount; abs(round_off.amount) < 1"
  },
  {
   "id": "S05",
   "detail": "TAX_MISMATCH",
   "rule": "tax.mode = intra when place_of_supply equals the company state else inter (none only for unregistered-composition setups); each head amount = round2(sum over lines of round4(taxable*head_rate/100)) with head rates per CALC_SPECS section 5"
  },
  {
   "id": "S06",
   "detail": "TAX_MISMATCH",
   "rule": "line gst_rate must equal the stock item master total GST rate (tm_stock_item_gst latest applicable_from <= date); charges use their own gst_rate"
  },
  {
   "id": "S07",
   "detail": "UNBALANCED",
   "rule": "bills amounts sum to the party amount (invoice total, receipt/payment amount); journal sum(dr) = sum(cr); contra from != to"
  },
  {
   "id": "S08",
   "detail": "PAYLOAD_INVALID",
   "rule": "party ledger not bill-wise (tm_ledger.is_billwise_on = false) => bills must be absent; receipt/payment bills[].type new_ref/agst_ref/advance/on_account allowed"
  },
  {
   "id": "S09",
   "detail": "LEDGER_NOT_FOUND",
   "rule": "every *_guid reference must exist in the synced tables; detail by kind: ledger=LEDGER_NOT_FOUND, stock_item=STOCK_ITEM_NOT_FOUND, godown=GODOWN_NOT_FOUND, voucher_type=VOUCHER_TYPE_NOT_FOUND, voucher=TARGET_NOT_FOUND, group/unit/stock_group=MASTER_NOT_FOUND"
  },
  {
   "id": "S10",
   "detail": "PAYLOAD_INVALID",
   "rule": "inventory_voucher: stock_journal uses source_lines + destination_lines (no lines, no party); notes use lines + party_ledger_guid"
  },
  {
   "id": "S11",
   "detail": "PAYLOAD_INVALID",
   "rule": "alter: action replace requires target_kind + replacement; einvoice_cancel requires reason; eway_generate requires eway.transporter_id or eway.vehicle_no"
  }
 ],
