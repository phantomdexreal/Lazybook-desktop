  "tally_message_map": [
   {
    "match": "(?i)ledger '?(.+?)'? (does not exist|not found)",
    "detail": "LEDGER_NOT_FOUND"
   },
   {
    "match": "(?i)stock item '?(.+?)'? (does not exist|not found)",
    "detail": "STOCK_ITEM_NOT_FOUND"
   },
   {
    "match": "(?i)godown '?(.+?)'? (does not exist|not found)",
    "detail": "GODOWN_NOT_FOUND"
   },
   {
    "match": "(?i)voucher type '?(.+?)'? (does not exist|not found)",
    "detail": "VOUCHER_TYPE_NOT_FOUND"
   },
   {
    "match": "(?i)(voucher number|number) .* already (exists|used)|duplicate voucher number",
    "detail": "VOUCHER_NUMBER_EXISTS"
   },
   {
    "match": "(?i)date .*(out of|outside).*(financial|books)|date is out of range",
    "detail": "DATE_OUT_OF_PERIOD"
   },
   {
    "match": "(?i)debit and credit .*(do not|don't) (match|tally)|difference in",
    "detail": "UNBALANCED"
   },
   {
    "match": "(?i)negative (stock|closing)",
    "detail": "NEGATIVE_STOCK"
   },
   {
    "match": "(?i)(bill|reference) .*(not found|does not exist)",
    "detail": "BILL_REF_NOT_FOUND"
   },
   {
    "match": "(?i)(already exists|duplicate name)",
    "detail": "MASTER_EXISTS"
   },
   {
    "match": "(?i)(company .*not (loaded|open)|no company)",
    "detail": "TALLY_COMPANY_NOT_LOADED"
   },
   {
    "match": "(?i)(irn|e-?invoice|e-?way)",
    "detail": "EINVOICE_REJECTED"
   }
  ],
  "note": "All Tally message patterns are assumed: verify on a real Tally and extend the list; unmatched messages map to UNKNOWN with the raw text in tally_raw."
 }
