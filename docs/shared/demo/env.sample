# demo/env.sample - PLACEHOLDERS ONLY. Copy into the repo's own env file (.env.local for admin and pwa; config for desktop). Never commit real values.
# Master Supabase project (public values: URL and anon key)
NEXT_PUBLIC_MASTER_URL=https://YOUR-MASTER-PROJECT-REF.supabase.co
NEXT_PUBLIC_MASTER_ANON_KEY=YOUR-MASTER-ANON-KEY
LB_MASTER_URL=https://YOUR-MASTER-PROJECT-REF.supabase.co
LB_MASTER_ANON_KEY=YOUR-MASTER-ANON-KEY
# PWA: run with no network at all against shared fixtures
NEXT_PUBLIC_MOCK_MODE=true
# Demo values (not secrets; same as constants.json demo)
LB_DEMO_LICENSE_KEY=LB-DEMO-0000-0000-0001
LB_DEMO_PASSPHRASE=correct horse battery staple
# Secrets are set in Supabase function secrets / GitHub secrets, never in a file:
# LB_CRON_SECRET, LB_CI_SECRET, personal access tokens, service role keys
